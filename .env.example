# Образец переменных окружения для клиентской сборки.
# Скопируй в .env и заполни реальными значениями.
# В коде доступ через process.env.<NAME> (DefinePlugin + dotenv-webpack).

# Боевой / тестовый режим (можно использовать для условных веток в JS)
NODE_ENV=development

# Версия API Bitrix (для rest-запросов из клиента)
BITRIX_API_VERSION=v1

# ID портала Bitrix24 (если используется)
# BITRIX24_PORTAL=your-portal.bitrix24.ru

# Базовый URL REST API
# BITRIX_REST_ENDPOINT=https://your-portal.bitrix24.ru/rest/